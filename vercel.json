{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://qroll-backend-five.vercel.app/api/$1" },
    { "source": "/health", "destination": "https://qroll-backend-five.vercel.app/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
